{
  "name": "nexi-agent",
  "version": "0.1.0",
  "description": "React components for AI-agent interfaces — streaming answers, thinking traces, approvals, tool calls, tables and more. Every component is content-free: pass your own data and text through props. Built on Beautiful UI.",
  "license": "MIT",
  "author": "Kaaylabs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abiramavarshini-kl/nexi-agent-component-package.git"
  },
  "homepage": "https://github.com/abiramavarshini-kl/nexi-agent-component-package#readme",
  "bugs": {
    "url": "https://github.com/abiramavarshini-kl/nexi-agent-component-package/issues"
  },
  "keywords": [
    "react",
    "ai",
    "agent",
    "chat",
    "streaming",
    "ui",
    "components",
    "tailwind",
    "llm"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./demo": {
      "import": {
        "types": "./dist/demo.d.ts",
        "default": "./dist/demo.js"
      },
      "require": {
        "types": "./dist/demo.d.cts",
        "default": "./dist/demo.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "LICENSE.beautiful-ui"
  ],
  "scripts": {
    "gen": "node scripts/make-index.mjs",
    "build": "npm run gen && tsup && node scripts/build-css.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --import tsx test/smoke.test.tsx",
    "playground": "npm run build && npm --prefix playground install && npm --prefix playground run dev",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "glimm": "^0.3.1",
    "iconoir-react": "^7.12.1",
    "liveline": "^0.0.7",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadow-plugin": "^2.1.1",
    "tailwindcss": "^4.3.3",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9"
  }
}
